# pasirputih additions on top of Firecracker's CI guest config
# (configs/microvm-kernel-ci-<arch>-6.1.config). build.sh merges this and
# fails if any line below does not end up in the final .config as written.

# VPN inside a VM: WireGuard in the kernel, TUN for OpenVPN, wireguard-go,
# Tailscale and the like.
CONFIG_WIREGUARD=y
CONFIG_TUN=y

# Full-tunnel routing as wg-quick and Tailscale set it up: policy routing on
# fwmarks, raw table + connmark (src_valid_mark), for IPv4 and IPv6.
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_RAW=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y

# nftables, which wg-quick and Tailscale prefer when present (kill switches
# too).
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_COMPAT=y
