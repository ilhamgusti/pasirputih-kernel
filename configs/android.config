# pp-android: pasirputih's guest kernel for Android in a sandbox (Waydroid:
# LXC + an Android image), on top of configs/pasirputih.config. Built with
# VARIANT=android: uname -r <version>-pp<PP_REV>-android. Other VMs keep the
# plain kernel.

# Binder: Android's IPC. Waydroid wants /dev/binder, /dev/hwbinder and
# /dev/vndbinder (it stops without them): made at boot; binderfs too.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Buffers for software rendering without a GPU (Firecracker has none):
# vgem gives a DRM render node for gbm allocations, udmabuf and dma-buf
# heaps turn memory into dma-bufs, sw_sync for fences.
CONFIG_DRM=y
CONFIG_DRM_VGEM=y
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_SW_SYNC=y

# Waydroid's network: a bridge (waydroid0) with NAT out and DHCP inside.
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_MANGLE=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# Input devices a container may create (uinput sits under "misc" input).
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y

# lmkd (a critical Android service: init reboots without it) works from
# pressure stall information; Firecracker's config has PSI built but off
# unless booted with psi=1.
# CONFIG_PSI_DEFAULT_DISABLED is not set
